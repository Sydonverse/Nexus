datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String?
  role         String   @default("INTERN") // ADMIN, TUTOR, INTERN
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  departmentMemberships   DepartmentMember[]
  uploadedResources       Resource[]
  announcements           Announcement[]
  schedules               ClassSchedule[]
  createdProjects         Project[]
  projectGroupMemberships ProjectGroupMember[]
  taskAssignments         TaskAssignment[]
  taskSubmissions         TaskSubmission[]
  givenFeedbacks          SubmissionFeedback[]
  sentMessages            Message[]
  pushSubscriptions       PushSubscription[]
  notifications           Notification[]
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String
  icon        String   @default("code")
  colorHex    String   @default("#6366f1")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  members       DepartmentMember[]
  resources     Resource[]
  announcements Announcement[]
  schedules     ClassSchedule[]
  projects      Project[]
  messages      Message[]
  notifications Notification[]
}

model DepartmentMember {
  id           String     @id @default(uuid())
  userId       String
  departmentId String
  role         String     @default("INTERN") // TUTOR, INTERN
  status       String     @default("APPROVED") // PENDING, APPROVED, REJECTED
  joinedAt     DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
}

model Resource {
  id           String   @id @default(uuid())
  departmentId String
  uploadedById String
  title        String
  description  String
  fileUrl      String
  fileName     String
  fileMimeType String
  fileSizeBytes Int
  category     String   @default("OTHER") // LECTURE, TUTORIAL, EXERCISE, REFERENCE, TOOL, OTHER
  tags         String?  // comma-separated tags or JSON
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  uploader   User       @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

model Announcement {
  id           String   @id @default(uuid())
  departmentId String
  authorId     String
  title        String
  content      String
  priority     String   @default("NORMAL") // NORMAL, IMPORTANT, URGENT
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model ClassSchedule {
  id            String   @id @default(uuid())
  departmentId  String
  scheduledById String
  title         String
  description   String
  startTime     DateTime
  endTime       DateTime
  location      String   @default("Hub Room A")
  meetingLink   String?
  createdAt     DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  scheduler  User       @relation(fields: [scheduledById], references: [id], onDelete: Cascade)
}

model Project {
  id           String    @id @default(uuid())
  departmentId String
  createdById  String
  title        String
  description  String
  status       String    @default("PLANNING") // PLANNING, IN_PROGRESS, REVIEW, COMPLETED
  startDate    DateTime?
  dueDate      DateTime?
  createdAt    DateTime  @default(now())

  department Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  creator    User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  groups     ProjectGroup[]
  tasks      Task[]
}

model ProjectGroup {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String?
  createdAt   DateTime @default(now())

  project Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members ProjectGroupMember[]
  tasks   Task[]
}

model ProjectGroupMember {
  id         String   @id @default(uuid())
  groupId    String
  userId     String
  role       String   @default("MEMBER") // LEAD, MEMBER
  assignedAt DateTime @default(now())

  group ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Task {
  id             String    @id @default(uuid())
  projectId      String
  projectGroupId String?
  title          String
  description    String
  status         String    @default("TODO") // TODO, IN_PROGRESS, IN_REVIEW, DONE
  priority       String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  dueDate        DateTime?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectGroup ProjectGroup?    @relation(fields: [projectGroupId], references: [id], onDelete: SetNull)
  assignments  TaskAssignment[]
  submissions  TaskSubmission[]
}

model TaskAssignment {
  id         String   @id @default(uuid())
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model TaskSubmission {
  id            String   @id @default(uuid())
  taskId        String
  submittedById String
  notes         String
  fileUrls      String?  // JSON stringified array of { name, url, size }
  submittedAt   DateTime @default(now())

  task        Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submitter   User                 @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  feedbacks   SubmissionFeedback[]
}

model SubmissionFeedback {
  id           String   @id @default(uuid())
  submissionId String
  reviewerId   String
  comment      String
  verdict      String   @default("NEEDS_REVISION") // APPROVED, NEEDS_REVISION, REJECTED
  createdAt    DateTime @default(now())

  submission TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User           @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
}

model Message {
  id             String   @id @default(uuid())
  departmentId   String
  senderId       String
  content        String
  attachmentUrls String?  // JSON string
  replyToId      String?
  createdAt      DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  sender     User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo    Message?   @relation("MessageReplies", fields: [replyToId], references: [id])
  replies    Message[]  @relation("MessageReplies")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id           String   @id @default(uuid())
  recipientId  String
  departmentId String?
  type         String   // ANNOUNCEMENT, CLASS_SCHEDULE, PROJECT_UPDATE, TASK_ASSIGNED, FEEDBACK, MESSAGE
  title        String
  body         String
  actionUrl    String
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  recipient  User        @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
}
